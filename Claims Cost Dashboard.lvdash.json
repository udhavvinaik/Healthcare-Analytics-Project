{
  "datasets": [
    {
      "name": "1173bdb1",
      "displayName": "Total Claim Cost",
      "queryLines": [
        "SELECT\n",
        "ROUND(SUM(TotalClaimCost),2) AS Total_Claim_Cost\n",
        "FROM healthcare.gold.fact_claims_cost;"
      ],
      "catalog": "healthcare",
      "schema": "gold"
    },
    {
      "name": "3baf667b",
      "displayName": "Total Claims",
      "queryLines": [
        "SELECT\r\n",
        "COUNT(DISTINCT claimid) AS Total_Claims\r\n",
        "FROM healthcare.gold.fact_claims_cost;"
      ],
      "catalog": "healthcare",
      "schema": "gold"
    },
    {
      "name": "f9236cc2",
      "displayName": "Average Claim Cost",
      "queryLines": [
        "SELECT\r\n",
        "ROUND(AVG(totalclaimcost),2) AS Avg_Claim_Cost\r\n",
        "FROM healthcare.gold.fact_claims_cost;"
      ],
      "catalog": "healthcare",
      "schema": "gold"
    },
    {
      "name": "08e686b5",
      "displayName": "Total Reimbursement",
      "queryLines": [
        "SELECT\r\n",
        "ROUND(SUM(ReimbursementAmount),2) AS Total_Reimbursement\r\n",
        "FROM healthcare.gold.fact_claims_cost;"
      ],
      "catalog": "healthcare",
      "schema": "gold"
    },
    {
      "name": "242b2e5c",
      "displayName": "Claims by Type",
      "queryLines": [
        "SELECT\r\n",
        "ClaimType,\r\n",
        "COUNT(*) AS Total_Claims,\r\n",
        "SUM(TotalClaimCost) AS Total_Cost\r\n",
        "FROM healthcare.gold.fact_claims_cost\r\n",
        "GROUP BY ClaimType;"
      ],
      "catalog": "healthcare",
      "schema": "gold"
    },
    {
      "name": "7b47d7d3",
      "displayName": "Monthly Claim Cost Trend",
      "queryLines": [
        "SELECT\r\n",
        "ClaimYearMonth,\r\n",
        "SUM(TotalClaimCost) AS Total_Cost\r\n",
        "FROM healthcare.gold.fact_claims_cost\r\n",
        "GROUP BY ClaimYearMonth\r\n",
        "ORDER BY ClaimYearMonth;"
      ],
      "catalog": "healthcare",
      "schema": "gold"
    },
    {
      "name": "86e1866e",
      "displayName": "Monthly Claim Volume",
      "queryLines": [
        "SELECT\r\n",
        "ClaimYearMonth,\r\n",
        "COUNT(*) AS Claim_Count\r\n",
        "FROM healthcare.gold.fact_claims_cost\r\n",
        "GROUP BY ClaimYearMonth\r\n",
        "ORDER BY ClaimYearMonth;"
      ],
      "catalog": "healthcare",
      "schema": "gold"
    },
    {
      "name": "a3f01284",
      "displayName": "Cost by State",
      "queryLines": [
        "SELECT\r\n",
        "State,\r\n",
        "SUM(TotalClaimCost) AS Total_Cost\r\n",
        "FROM healthcare.gold.fact_claims_cost\r\n",
        "GROUP BY State\r\n",
        "ORDER BY Total_Cost DESC;"
      ],
      "catalog": "healthcare",
      "schema": "gold"
    },
    {
      "name": "855923f6",
      "displayName": "Top 10 Providers by Cost",
      "queryLines": [
        "SELECT\r\n",
        "ProviderID,\r\n",
        "SUM(TotalClaimCost) AS Total_Cost\r\n",
        "FROM healthcare.gold.fact_claims_cost\r\n",
        "GROUP BY ProviderID\r\n",
        "ORDER BY Total_Cost DESC\r\n",
        "LIMIT 10;"
      ],
      "catalog": "healthcare",
      "schema": "gold"
    },
    {
      "name": "5195091e",
      "displayName": "Top Providers by Claim Count",
      "queryLines": [
        "SELECT\r\n",
        "ProviderID,\r\n",
        "COUNT(*) AS Total_Claims\r\n",
        "FROM healthcare.gold.fact_claims_cost\r\n",
        "GROUP BY ProviderID\r\n",
        "ORDER BY Total_Claims DESC\r\n",
        "LIMIT 10;"
      ],
      "catalog": "healthcare",
      "schema": "gold"
    },
    {
      "name": "c2165d4e",
      "displayName": "Cost by Age Group",
      "queryLines": [
        "SELECT\r\n",
        "AgeGroup,\r\n",
        "SUM(TotalClaimCost) AS Total_Cost,\r\n",
        "COUNT(*) AS Total_Claims\r\n",
        "FROM healthcare.gold.fact_claims_cost\r\n",
        "GROUP BY AgeGroup\r\n",
        "ORDER BY AgeGroup;"
      ],
      "catalog": "healthcare",
      "schema": "gold"
    },
    {
      "name": "5b72df89",
      "displayName": "Average Cost by Age Group",
      "queryLines": [
        "SELECT\r\n",
        "AgeGroup,\r\n",
        "ROUND(AVG(TotalClaimCost),2) AS Avg_Cost\r\n",
        "FROM healthcare.gold.fact_claims_cost\r\n",
        "GROUP BY AgeGroup\r\n",
        "ORDER BY AgeGroup;"
      ],
      "catalog": "healthcare",
      "schema": "gold"
    },
    {
      "name": "286d8f10",
      "displayName": "Fraud vs Non-Fraud Cost",
      "queryLines": [
        "SELECT\r\n",
        "    PotentialFraud,\r\n",
        "    ClaimType,\r\n",
        "    SUM(TotalClaimCost) AS Total_Cost\r\n",
        "FROM healthcare.gold.fact_claims_cost\r\n",
        "GROUP BY PotentialFraud, ClaimType;"
      ],
      "catalog": "healthcare",
      "schema": "gold"
    },
    {
      "name": "66e47b62",
      "displayName": "Claims by Quarter",
      "queryLines": [
        "SELECT\r\n",
        "    ClaimYear,\r\n",
        "    ClaimQuarter,\r\n",
        "    SUM(TotalClaimCost) AS Total_Cost\r\n",
        "FROM healthcare.gold.fact_claims_cost\r\n",
        "GROUP BY ClaimYear, ClaimQuarter\r\n",
        "ORDER BY ClaimYear, ClaimQuarter;"
      ],
      "catalog": "healthcare",
      "schema": "gold"
    }
  ],
